{
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "vite build && esbuild server/_core/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=api/index.cjs",
  "outputDirectory": "dist/public",
  "env": {
    "JWT_SECRET": { "description": "Secret key for JWT/cookie signing" },
    "DATABASE_URL": { "description": "PostgreSQL connection string" },
    "LLM_API_KEY": { "description": "OpenAI or Claude API key" },
    "LLM_BASE_URL": { "description": "LLM API base URL (optional, defaults to OpenAI)" },
    "LLM_MODEL": { "description": "LLM model to use (optional, defaults to gpt-4o-mini)" },
    "ADMIN_EMAIL": { "description": "Admin account email" },
    "ADMIN_PASSWORD": { "description": "Admin account password" },
    "SUPABASE_URL": { "description": "Supabase project URL" },
    "SUPABASE_KEY": { "description": "Supabase API key" },
    "SUPABASE_BUCKET": { "description": "Supabase storage bucket name" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
